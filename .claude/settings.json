{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/careful-check.sh",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/freeze-check.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/security-check.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/path-hardcode-check.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/doubt-validator.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/verify-completion.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
